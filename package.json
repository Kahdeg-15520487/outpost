{
  "name": "outpost",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted AI workspace on pi-durable: durable agents, sandboxed modules, capability Airlocks.",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @outpost/server dev",
    "dev:web": "pnpm --filter @outpost/web dev",
    "build": "pnpm --filter @outpost/web build",
    "start": "pnpm build && pnpm --filter @outpost/server start",
    "migration": "pnpm --filter @outpost/server exec tsx scripts/migrate.ts",
    "migrate": "pnpm --filter @outpost/server exec tsx scripts/migrate.ts",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter @outpost/server smoke",
    "test": "pnpm build && pnpm typecheck && pnpm --filter @outpost/server test"
  }
}
