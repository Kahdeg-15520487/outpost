# dependencies & build output
node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/

# runtime data: workspaces, uploads, system db (never commit)
data/
outpost-data/
*.sqlite
*.sqlite-*
*.db

# local config & secrets (outpost.config.example.json is the template)
outpost.config.json
outpost.config.*.json
!outpost.config.example.json
.env
.env.*
!.env.example
*.key
*.pem

# logs & scratch
*.log
# release snapshots, not source
/outpost.zip
npm-debug.log*
pnpm-debug.log*
*.tmp.*
_*.py
*.png
!packages/**/assets/**/*.png
screenshots/

# editors & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
