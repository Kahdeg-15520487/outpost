# Keys for docker compose. Copy to .env and fill in what you use; .env is gitignored.
# Anything left empty just means that provider isn't available.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=

# Optional. 32 bytes as 64 hex chars or base64; keeps sessions and stored keys valid if you ever
# re-create the data volume. Without it, pi-os writes /data/secret.key on first run.
# PI_OS_SECRET=

# Optional. Which host interface the app and the preview range are published on.
# PI_OS_BIND=127.0.0.1
# PI_OS_PORT=8787
